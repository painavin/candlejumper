# The public registry, explicitly.
#
# Without this, npm falls back to the machine's global config. On a machine
# configured against an internal mirror, every `npm install` rewrites the
# `resolved` URLs in package-lock.json to that mirror's hostname — and since
# GitHub's runners can't reach it, `npm ci` fails on the next push with no local
# symptom whatsoever. That is exactly how the first deploy of this workflow broke.
#
# Pinning it here keeps the lockfile installable from anywhere, which a public
# repo that builds in CI requires.
registry=https://registry.npmjs.org
