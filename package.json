{
  "name": "candlejumper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A trading-habit trainer disguised as an endless side scroller",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "datasets": "node --max-old-space-size=3072 scripts/datasets.mjs",
    "tauri": "npx --yes @tauri-apps/cli@^2",
    "desktop:dev": "npm run tauri -- dev",
    "desktop:build": "npm run tauri -- build",
    "android:sync": "npm run build && npx --yes @capacitor/cli@^7 sync android",
    "android:open": "npx --yes @capacitor/cli@^7 open android",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "pixi.js": "^8.19.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
