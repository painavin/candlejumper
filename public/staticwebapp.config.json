{
  "routes": [
    {
      "route": "/datasets/manifest.json",
      "headers": {
        "cache-control": "public, max-age=300, must-revalidate"
      }
    },
    {
      "route": "/datasets/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/midi/*",
      "headers": {
        "cache-control": "public, max-age=3600, must-revalidate"
      }
    }
  ],
  "mimeTypes": {
    ".mid": "audio/midi",
    ".midi": "audio/midi"
  }
}
